# ---------------------------------------------------------------------------
# EAEU Regulatory Assistant — example environment file.
# Скопируйте (НЕ переименуйте) в `.env` и заполните нужные значения:
#     Copy-Item .env.example .env
# Файл `.env` исключён из Git; реальные ключи в репозиторий не попадают.
# ---------------------------------------------------------------------------

# --- LLM -------------------------------------------------------------------
# anthropic | openai | none   ("none" = режим только поиска, без генерации)
LLM_PROVIDER=anthropic
ANTHROPIC_API_KEY=
OPENAI_API_KEY=

# Необязательно: адрес API-эндпоинта. Позволяет работать с любым сервисом,
# совместимым с интерфейсом OpenAI (региональный провайдер, корпоративный шлюз
# или локальный сервер вроде Ollama / LM Studio), не меняя код.
# Нужен, если провайдер отвечает 403 unsupported_country_region_territory.
# Пример для локальной модели:  OPENAI_BASE_URL=http://localhost:11434/v1
OPENAI_BASE_URL=
ANTHROPIC_BASE_URL=

# Пусто — модель по умолчанию для выбранного провайдера
# (anthropic -> claude-sonnet-4-5-20250929, openai -> gpt-4o)
MODEL_NAME=
LLM_TEMPERATURE=0.0
LLM_MAX_TOKENS=4096

# --- Embeddings ------------------------------------------------------------
# local  -> sentence-transformers, работает офлайн, без оплаты API (по умолчанию)
# openai -> text-embedding-3-large, требует OPENAI_API_KEY
EMBEDDING_PROVIDER=local
EMBEDDING_MODEL=intfloat/multilingual-e5-base
OPENAI_EMBEDDING_MODEL=text-embedding-3-large
EMBEDDING_BATCH_SIZE=16
# cpu | cuda | (пусто = определить автоматически)
EMBEDDING_DEVICE=

# --- Vector store ----------------------------------------------------------
# local  -> встроенный Qdrant, файлы в ./database/qdrant
# server -> Qdrant из docker-compose.yml
QDRANT_MODE=local
QDRANT_URL=http://localhost:6333
QDRANT_API_KEY=
QDRANT_COLLECTION=eaeu_regulatory_chunks

# --- Retrieval -------------------------------------------------------------
VECTOR_TOP_K=40
BM25_TOP_K=40
FINAL_TOP_K=12
RRF_K=60
RRF_VECTOR_WEIGHT=1.0
RRF_BM25_WEIGHT=1.0

# --- Reranking (опционально, скачивает кросс-энкодер ~2.2 ГБ) --------------
RERANK_ENABLED=false
RERANK_MODEL=BAAI/bge-reranker-v2-m3
RERANK_CANDIDATES=40

# --- Chunking --------------------------------------------------------------
CHUNK_TARGET_CHARS=1600
CHUNK_MAX_CHARS=2600
CHUNK_OVERLAP_CHARS=200

# --- Ingestion / network ---------------------------------------------------
HTTP_USER_AGENT=EAEU-Regulatory-Assistant/1.0 (academic research project; contact: student@example.edu)
HTTP_TIMEOUT_SECONDS=90
HTTP_RETRIES=3
HTTP_RATE_LIMIT_SECONDS=1.0

# --- Behaviour -------------------------------------------------------------
SUPPLEMENTARY_SOURCES_ENABLED=true
LOG_LEVEL=INFO

# --- OCR (сканы без текстового слоя) ---------------------------------------
# Путь к tesseract.exe; пусто — если бинарь уже в PATH.
TESSERACT_CMD=
OCR_DPI=200
OCR_LANGUAGES=rus+eng

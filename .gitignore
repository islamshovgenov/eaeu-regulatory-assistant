# --- secrets ---------------------------------------------------------------
.env
.env.*
!.env.example
*.key
*.pem
secrets.*

# --- python ----------------------------------------------------------------
__pycache__/
*.py[cod]
*.egg-info/
.eggs/
build/
dist/
.venv/
venv/
env/
